# Dashboard (may be deployed)
APP_SECRET=replace-with-a-long-random-value
ADMIN_PASSWORD=change-me
WORKER_TOKEN=replace-with-another-long-random-value
DATABASE_PATH=./data/autopost.db
PORT=8000

# Local agent
SERVER_URL=http://127.0.0.1:8000
AGENT_NAME=studio-mac
POLL_SECONDS=5
# Hidemyacc 3.x mặc định 2268; agent tự thử thêm port legacy 12368
HIDEMYACC_API=http://127.0.0.1:2268
OUTPUT_DIR=./output
FFMPEG_BIN=ffmpeg
HEADLESS=false
DRY_RUN=true
